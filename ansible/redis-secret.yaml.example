---
# -------------------------------------------------------------------------------
# REDIS SECRET TEMPLATE (redis-secret.yaml.example)
# INSTRUCTIONS: 
# 1. Copy this file to 'ansible/redis-secret.yaml'
# 2. Replace 'your-base64-password-here' with your real base64-encoded password.
# 3. Use 'echo -n "your-password" | base64' to generate the value.
# -------------------------------------------------------------------------------

apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: default
type: Opaque
data:
  password: <your-base64-password-here>
